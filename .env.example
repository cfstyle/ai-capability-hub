# AI Capability Hub - 环境变量配置
# 复制此文件为 .env 并根据需要修改

# Hub Core
HUB_PORT=8080
HUB_ENV=development
HUB_LOG_LEVEL=INFO
HUB_ADMIN_API_KEY=dev-admin-key
# 与 RgOne 统一网关对外地址对齐，例如 http://<rgone-host>/mcp
HUB_PUBLIC_MCP_URL=
# 信任 RgOne 小秘书 JWT 所需的共享验签密钥（生产环境必须与 RgOne JWT_SECRET 保持一致且不可使用默认值）
HUB_RGONE_JWT_SECRET=
HUB_RGONE_JWT_ISSUER=rgone
# Hub 签发 ide-client 长效 MCP Token 的独立密钥（生产环境必填且必须与 HUB_RGONE_JWT_SECRET 不同）
HUB_MCP_JWT_SECRET=
HUB_JWT_ISSUER=ai-capability-hub
HUB_TRUST_RGONE_ADMIN_JWT=true
# 与 RgOne 后端之间内部同步接口密钥（X-Internal-Secret）
HUB_INTERNAL_SERVICE_SECRET=

# 个人业务凭据对称加密主密钥（生产环境 HUB_ENV=production 必填，可使用 Fernet 密钥或高强度随机字符串）
# 生成示例: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：容器重建时必须保持该密钥不变并保留 hub-data 卷，否则历史绑定凭据无法解密。
HUB_CREDENTIAL_ENCRYPTION_KEY=
